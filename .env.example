# All values are optional; defaults work out of the box.
EVALFORGE_DATASET=data/golden/cases.jsonl
EVALFORGE_DB=data/evalforge.db
EVALFORGE_BASELINE=baselines/baseline.json
EVALFORGE_REPORTS=reports

# MLflow: default is an embedded SQLite store. Point at `docker compose up mlflow` with http://localhost:5000
MLFLOW_TRACKING_URI=sqlite:///data/mlflow.db
MLFLOW_EXPERIMENT=evalforge

# Judge: auto (Ollama if reachable, else rule-based) | ollama | rule
EVALFORGE_JUDGE=auto
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=60

# Cost model (USD per 1M tokens) used for the cost metric
EVALFORGE_PRICE_IN_PER_1M=0.50
EVALFORGE_PRICE_OUT_PER_1M=1.50

# Regression gate thresholds (absolute drops that fail the build)
EVALFORGE_MAX_SCORE_DROP=0.02
EVALFORGE_MAX_PASS_RATE_DROP=0.04
EVALFORGE_MAX_JUDGE_DROP=0.05
EVALFORGE_MAX_TASK_PASS_DROP=0.15
